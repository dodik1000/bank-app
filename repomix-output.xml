<file path="src/pages/Dashboard/sass/index.scss">
@use "sass:color";
@use "../../../styles/variables" as *;

// wrapper styles
.dashboard-wrapper {
  background-color: #f8f9fa;
  min-height: 100vh;
  padding: 20px;
  color: $color-text-main;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  display: flex;
  align-items: center;
  justify-content: center;

  @media (min-width: 768px) {
    padding: 40px;
  }
}

// container styles
.dashboard-container {
  width: 100%;
  max-width: 480px;
  background: #f5f5f5;
  border-radius: 24px;
  padding: 24px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  border: 1px solid color.mix(#f5f5f5, $color-border-default, 85%);
  display: flex;
  flex-direction: column;

  @media (min-width: 768px) {
    max-width: 900px;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 12px;
    padding: 40px;
    align-items: start;
  }
}

// profile subpage container
.profile-container {
  width: 100%;
  max-width: 540px;
  background: #f5f5f5;
  border-radius: 24px;
  padding: 32px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  border: 1px solid color.mix(#f5f5f5, $color-border-default, 85%);
  display: flex;
  flex-direction: column;

  .profile-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;

    h2 {
      font-size: 22px;
      font-weight: 800;
      margin: 0;
    }
  }

  .profile-info-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 8px 20px;
    border: 1px solid color.mix(#fff, $color-border-default, 90%);
    margin-bottom: 12px;

    .info-row {
      display: flex;
      flex-direction: column;
      padding: 14px 0;
      border-bottom: 1px solid #f0f2f5;

      &:last-child {
        border-bottom: none;
      }

      .info-label {
        font-size: 12px;
        color: $color-text-muted;
        font-weight: 500;
        margin-bottom: 4px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .info-value {
        font-size: 16px;
        font-weight: 600;
        color: $color-text-main;
      }
    }
  }
}

// interactive profile button widget
.btn-profile-widget {
  background: $color-primary;
  border-radius: 16px;
  padding: 10px 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
  transition: all 0.2s ease;
  border: 0;
  margin-bottom: 10px;

  &:hover {
    transform: translateY(-2px);
    background-color: $color-primary-hover;
  }

  .profile-icon-avatar {
    font-size: 18px;
  }

  .profile-text-name {
    font-size: 15px;
    font-weight: 700;
    color: #f5f5f5;
  }
}

.btn-logout {
  background: none;
  border: none;
  color: $color-danger;
  font-weight: 600;
  font-size: 18px;
  cursor: pointer;
  padding: 12px;
  border-radius: 12px;
  transition: background-color 0.2s;
  width: 100%;
  margin-top: 24px;
  text-align: center;
  box-sizing: border-box;

  &:hover {
    background-color: $color-danger-bg;
  }

  @media (min-width: 768px) {
    grid-column: 1 / span 2;
    max-width: 200px;
    margin: 24px auto 0 auto;
  }
}

// balance panel
.balance-section {
  text-align: center;
  margin-bottom: 32px;

  @media (min-width: 768px) {
    text-align: left;
    margin-bottom: 0;
    position: sticky;
    top: 40px;
  }

  .balance-label {
    color: $color-text-muted;
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
  }

  .balance-amount {
    font-size: 38px;
    font-weight: 800;
    letter-spacing: -1px;
    margin-bottom: 24px;
  }
}

// layout grid
.action-buttons {
  display: flex;
  justify-content: center;
  gap: 12px;

  @media (min-width: 768px) {
    justify-content: flex-start;
  }
}

// global buttons
.btn-pill {
  padding: 12px 24px;
  border-radius: 30px;
  font-weight: 600;
  font-size: 15px;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;

  &.btn-primary {
    background-color: $color-primary;
    color: #f5f5f5;
    &:hover {
      background-color: $color-primary-hover;
    }
  }

  &.btn-secondary {
    background-color: $color-text-main;
    color: #f5f5f5;
    &:hover {
      background-color: color.adjust($color-text-main, $lightness: 10%);
    }
  }

  &.btn-full {
    width: 100%;
    justify-content: center;
  }
}

// accounts layout
.accounts-section {
  h3 {
    font-size: 16px;
    font-weight: 600;
    color: $color-text-muted;
    margin-top: 0;
  }

  .accounts-empty-state {
    color: #7d8591;
    font-size: 14px;
    font-weight: 600;
  }
}

// card styles
.account-card {
  background: linear-gradient(
    135deg,
    $color-primary 0%,
    color.adjust($color-primary, $lightness: -15%) 100%
  );
  color: #f5f5f5;
  padding: 24px;
  border-radius: 18px;
  margin-bottom: 16px;
  position: relative;
  box-shadow: 0 8px 20px rgba($color-primary, 0.15);

  .card-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 28px;

    h4 {
      margin: 0;
      font-size: 16px;
    }
    .card-number {
      font-size: 13px;
      background: rgba(245, 245, 245, 0.15);
      padding: 2px 8px;
      border-radius: 6px;
    }
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;

    .card-balance {
      font-size: 24px;
      font-weight: 700;
    }
    .btn-deposit {
      background: #f5f5f5;
      color: $color-text-main;
      border: none;
      padding: 8px 16px;
      border-radius: 12px;
      font-weight: 600;
      cursor: pointer;
    }
  }
}

// fields styles
.form-group {
  margin-bottom: 20px;

  label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 8px;
    color: $color-text-main;
  }

  .input-default {
    width: 100%;
    padding: 12px 16px;
    border-radius: 10px;
    border: 1px solid $color-border-default;
    font-size: 15px;
    box-sizing: border-box;
    outline: none;
    transition: border-color 0.2s;

    &:focus {
      border-color: $color-primary;
    }
    &.input-error {
      border-color: $color-danger;
    }
  }

  .select-default {
    width: 100%;
    padding: 12px 16px;
    border-radius: 10px;
    border: 1px solid $color-border-default;
    font-size: 15px;
    box-sizing: border-box;
    outline: none;
    background-color: #f5f5f5;
    cursor: pointer;
    transition: border-color 0.2s;

    &:focus {
      border-color: $color-primary;
    }
    &.input-error {
      border-color: $color-danger;
    }
  }

  .error-message {
    color: $color-danger;
    font-size: 13px;
    margin-top: 6px;
  }
}

// operations block styles
.operations-section {
  h3 {
    font-size: 16px;
    font-weight: 600;
    color: $color-text-muted;
  }

  .operations-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .operation-item {
    background: $color-primary;
    border-radius: 16px;
    padding: 16px 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    transition: all 0.2s ease;

    &:hover {
      transform: translateY(-2px);
      background-color: $color-primary-hover;
    }

    .operation-icon {
      font-size: 22px;
    }

    .operation-label {
      font-size: 15px;
      font-weight: 600;
      color: #f5f5f5;
      text-align: center;
    }
  }

  @media (min-width: 420px) {
    .operations-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 570px) {
    grid-column: 1 / span 2;
    .operations-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
}

// confirm dialog layout
.confirm-buttons {
  display: flex;
  gap: 12px;
  margin-top: 24px;

  .btn-pill {
    flex: 1;
    width: auto;
  }
}

.confirm-modal-text {
  font-size: 15px;
  line-height: 1.5;
  color: #070c14;
  margin: 0 0 20px 0;
}

// loader animation
.loader {
  width: 40px;
  height: 40px;
  border: 4px solid color.mix(#f5f5f5, $color-border-default, 85%);
  border-top-color: $color-primary;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
